# Trafikverket Öppet API (TrafficInformation) — beställ nyckel på data.trafikverket.se
TRAFIKVERKET_API_KEY=

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Webbens geocoding/routing. Defaults i webben fungerar för lokal MVP-test,
# men produktion bör använda dedikerade provider-instanser eller nycklar.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
NOMINATIM_USER_AGENT=Sakravagar.se MVP geocoder (https://sakravagar.se)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Direkt Postgres-connection (Supabase: Project Settings → Database → Connection string → "Session pooler")
# Används endast för scripts/import-nvdb.sh. Inte del av scraper/web.
DATABASE_URL=

{
  "name": "trafik",
  "private": true,
  "version": "0.0.0",
  "description": "Historisk olycksdata på svenska vägar — hjälper nervösa förare hitta tryggare rutter.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "pnpm --filter @trafik/scraper run start",
    "scrape:dev": "pnpm --filter @trafik/scraper run dev",
    "web": "pnpm --filter @trafik/web run dev",
    "build:web": "pnpm --filter @trafik/web run build",
    "typecheck": "pnpm -r run typecheck"
  }
}
